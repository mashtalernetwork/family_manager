# Application
APP_NAME=Family Manager API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_DB=family_manager
POSTGRES_USER=family_manager
POSTGRES_PASSWORD=family_manager
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://family_manager:family_manager@localhost:5432/family_manager

# LLM: openai | gigachat | disabled
LLM_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_SCOPE=GIGACHAT_API_PERS
